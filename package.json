{
  "name": "strx-animation-intellisense",
  "displayName": "Strx Animation Intellisense",
  "description": "Autocomplete, hover docs, and diagnostics for react-native-strx animate tokens",
  "version": "0.2.1",
  "publisher": "strx",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "react-native",
    "reanimated",
    "animation",
    "strx",
    "tailwind",
    "intellisense"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "STRX Animation",
      "properties": {
        "strxAnimation.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for unknown or invalid tokens in animate strings."
        }
      }
    },
    "commands": [
      {
        "command": "strxAnimation.reloadTokens",
        "title": "Reload Token Metadata",
        "category": "STRX Animation"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "homepage": "https://wangjagom.github.io/react-native-strx/docs/editor.html",
  "bugs": {
    "url": "https://github.com/wangjagom/strx-animation-intellisense/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangjagom/strx-animation-intellisense.git"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.9"
  }
}

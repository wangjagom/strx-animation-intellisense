{
  "schemaVersion": 1,
  "library": "1.0.0-beta.0",
  "presets": [
    {
      "name": "fade-in",
      "initial": {
        "opacity": 0
      },
      "target": {
        "opacity": 1
      },
      "motion": "timing, 300ms"
    },
    {
      "name": "fade-out",
      "initial": {
        "opacity": 1
      },
      "target": {
        "opacity": 0
      },
      "motion": "timing, 250ms"
    },
    {
      "name": "slide-up",
      "initial": {
        "translateY": 24
      },
      "target": {
        "translateY": 0
      },
      "motion": "timing, 320ms"
    },
    {
      "name": "slide-down",
      "initial": {
        "translateY": -24
      },
      "target": {
        "translateY": 0
      },
      "motion": "timing, 320ms"
    },
    {
      "name": "slide-left",
      "initial": {
        "translateX": 24
      },
      "target": {
        "translateX": 0
      },
      "motion": "timing, 320ms"
    },
    {
      "name": "slide-right",
      "initial": {
        "translateX": -24
      },
      "target": {
        "translateX": 0
      },
      "motion": "timing, 320ms"
    },
    {
      "name": "scale-up",
      "initial": {
        "scale": 0.92
      },
      "target": {
        "scale": 1
      },
      "motion": "timing, 260ms"
    },
    {
      "name": "scale-in",
      "initial": {
        "scale": 0.92
      },
      "target": {
        "scale": 1
      },
      "motion": "timing, 260ms"
    },
    {
      "name": "scale-down",
      "initial": {
        "scale": 1.08
      },
      "target": {
        "scale": 1
      },
      "motion": "timing, 260ms"
    },
    {
      "name": "scale-out",
      "initial": {
        "scale": 1
      },
      "target": {
        "scale": 0.92
      },
      "motion": "timing, 220ms"
    },
    {
      "name": "bounce",
      "initial": {
        "translateY": -16,
        "scale": 0.96
      },
      "target": {
        "translateY": 0,
        "scale": 1
      },
      "motion": "spring, damping 8, stiffness 180, mass 0.9"
    }
  ],
  "easings": [
    {
      "token": "linear",
      "description": "Linear easing."
    },
    {
      "token": "ease",
      "description": "Smoothstep easing."
    },
    {
      "token": "ease-in",
      "description": "Cubic ease-in."
    },
    {
      "token": "ease-out",
      "description": "Cubic ease-out. Default when no easing is set."
    },
    {
      "token": "ease-in-out",
      "description": "Cubic ease-in-out."
    }
  ],
  "spring": {
    "token": "spring",
    "description": "Uses the spring driver for numeric channels."
  },
  "numericTiming": [
    {
      "prefix": "duration-",
      "example": "duration-300",
      "description": "Duration in milliseconds. Precedence: token or object → preset default → Strx.Provider duration → 300ms."
    },
    {
      "prefix": "delay-",
      "example": "delay-100",
      "description": "Delay in milliseconds before the animation starts."
    },
    {
      "prefix": "damping-",
      "example": "damping-12",
      "description": "Spring damping. Default 10."
    },
    {
      "prefix": "stiffness-",
      "example": "stiffness-180",
      "description": "Spring stiffness. Default 100."
    },
    {
      "prefix": "mass-",
      "example": "mass-1",
      "description": "Spring mass. Default 1."
    }
  ],
  "countTiming": [
    {
      "prefix": "play-",
      "example": "play-3",
      "description": "Total number of plays, or `play-infinite`.",
      "legacy": false
    },
    {
      "prefix": "repeat-",
      "example": "repeat-3",
      "description": "Same as `play-*`; kept for compatibility.",
      "legacy": true
    }
  ],
  "keyframePrefixes": [
    {
      "prefix": "from:",
      "description": "Style before the animation starts."
    },
    {
      "prefix": "to:",
      "description": "Target style of the animation."
    },
    {
      "prefix": "exit:",
      "description": "Style animated to when the component unmounts."
    }
  ],
  "utilities": [
    {
      "prefix": "opacity-",
      "property": "opacity",
      "signed": false,
      "example": "opacity-50",
      "result": "opacity: 0.5",
      "max": 100
    },
    {
      "prefix": "translate-x-",
      "property": "translateX",
      "signed": true,
      "example": "translate-x-20",
      "result": "translateX: 20"
    },
    {
      "prefix": "translate-y-",
      "property": "translateY",
      "signed": true,
      "example": "translate-y-20",
      "result": "translateY: 20"
    },
    {
      "prefix": "scale-x-",
      "property": "scaleX",
      "signed": false,
      "example": "scale-x-95",
      "result": "scaleX: 0.95"
    },
    {
      "prefix": "scale-y-",
      "property": "scaleY",
      "signed": false,
      "example": "scale-y-105",
      "result": "scaleY: 1.05"
    },
    {
      "prefix": "scale-",
      "property": "scale",
      "signed": false,
      "example": "scale-90",
      "result": "scale: 0.9"
    },
    {
      "prefix": "rotate-",
      "property": "rotate",
      "signed": true,
      "example": "rotate-45",
      "result": "rotate: '45deg'"
    },
    {
      "prefix": "w-",
      "property": "width",
      "signed": false,
      "example": "w-120",
      "result": "width: 120"
    },
    {
      "prefix": "h-",
      "property": "height",
      "signed": false,
      "example": "h-80",
      "result": "height: 80"
    }
  ],
  "transitions": [
    {
      "token": "transition",
      "kind": "all",
      "description": "All supported numeric, color, and transform channels."
    },
    {
      "token": "transition-all",
      "kind": "all",
      "description": "All supported numeric, color, and transform channels."
    },
    {
      "token": "transition-colors",
      "kind": "colors",
      "description": "Color keys such as `backgroundColor` and `borderColor`."
    },
    {
      "token": "transition-opacity",
      "kind": "opacity",
      "description": "`opacity` only."
    },
    {
      "token": "transition-transform",
      "kind": "transform",
      "description": "Transform channels such as `translateX`, `scale`, and `rotate`."
    },
    {
      "token": "transition-spacing",
      "kind": "spacing",
      "description": "`margin*` and `padding*` keys."
    },
    {
      "token": "transition-layout",
      "kind": "layout",
      "description": "`width`, `height`, min/max sizes, and `top`/`right`/`bottom`/`left`."
    }
  ],
  "layout": [
    {
      "token": "layout-linear",
      "description": "Timing transition.",
      "motion": "300ms, or duration-* / provider duration"
    },
    {
      "token": "layout-spring",
      "description": "Spring transition.",
      "motion": "damping 15, stiffness 120, mass 1"
    },
    {
      "token": "layout-fade",
      "description": "Timing transition that also fades the view in.",
      "motion": "300ms, or duration-* / provider duration"
    },
    {
      "token": "layout-spring-stiff",
      "description": "Stiffer spring transition.",
      "motion": "damping 20, stiffness 180, mass 0.9"
    },
    {
      "token": "layout-spring-bouncy",
      "description": "Bouncier spring transition.",
      "motion": "damping 10, stiffness 105, mass 1"
    }
  ]
}
